---
# Generated by Ansible from templates/globals.yml.j2.
# Change values in inventory/group_vars/all.yml and re-run `make kolla-config`; do not hand-edit.
kolla_base_distro: "{{ kolla_distro }}"
openstack_release: "{{ openstack_release }}"

# Internal VIP: a free ZeroTier address, NOT any node's own IP.
kolla_internal_vip_address: "{{ internal_vip }}"

# Management / API / tunnel traffic rides ZeroTier. Provider traffic uses the dedicated NIC.
network_interface: "{{ zt_iface }}"
neutron_external_interface: "{{ provider_nic }}"

neutron_plugin_agent: "openvswitch"
enable_neutron_provider_networks: "yes"

nova_compute_virt_type: "kvm"

enable_haproxy: "yes"
enable_keepalived: "yes"
enable_horizon: "yes"

enable_cinder: "yes"
enable_cinder_backend_lvm: "yes"
cinder_volume_group: "{{ cinder_vg }}"

enable_heat: "{{ enable_heat }}"
enable_swift: "{{ enable_swift }}"
{% if glance_use_nfs %}

glance_file_datadir_volume: "{{ glance_nfs_mount }}"
{% endif %}
